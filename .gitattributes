# XLIFF translation files
*.xlf text eol=lf linguist-language=XML
*.xml text eol=lf

# Ensure consistent line endings
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Export-ignore: exclude dev files from git archive (GitHub release archives, Composer dists)
/.bestpractices.json    export-ignore
/.ddev                  export-ignore
/.github                export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.gitleaks.toml         export-ignore
/.php-cs-fixer.dist.php export-ignore
/.semgrepignore         export-ignore
/Build                  export-ignore
/Tests                  export-ignore
/docs                   export-ignore
AGENTS.md               export-ignore
CLAUDE.md               export-ignore
/CHANGELOG.md           export-ignore
/ChangeLog              export-ignore
/CODE_OF_CONDUCT.md     export-ignore
/CONTRIBUTING.md        export-ignore
/SECURITY.md            export-ignore
/Makefile               export-ignore
/composer.lock          export-ignore
/fractor.php            export-ignore
/infection.json5        export-ignore
/rector.php             export-ignore
/renovate.json          export-ignore
