# The shared config of netresearch/typo3-ci-workflows sets level 10,
# treatPhpDocTypesAsCertain, the strictness flags and the excludePaths;
# phpstan/extension-installer registers phpstan-typo3, phpat and the other
# PHPStan extensions. phpstan-shared.php includes it only where the package
# is installed, see the comment there.
includes:
    - phpstan-shared.php
    - phpat.neon

parameters:
    paths:
        - ../Classes/
        - ../Configuration/
        - ../Tests/
        - ../ext_localconf.php

    # Ignores that still match an error. The shared config reports unmatched
    # ignores, so an entry that stops matching has to be removed.
    ignoreErrors:
        # TYPO3 TCA/GLOBALS access patterns - inherently untyped
        - '#Cannot cast mixed to string#'

        # PHPStan strict rules violations in legacy code
        - '#should return .* but returns#'

        # Test assertions with known types
        -
            message: '#will always evaluate to true#'
            paths:
                - ../Tests/*

        # Parent constructor not called (intentional in test stubs)
        -
            message: '#does not call parent constructor#'
            paths:
                - ../Tests/*

        # Deprecated method calls in tests (testing deprecated APIs)
        -
            message: '#Call to deprecated method#'
            paths:
                - ../Tests/*
